registry=https://registry.npmmirror.com/
# electron-builder downloads the Electron binary and its SHASUMS256.txt through
# @electron/get, which reads this npm config key (npm_config_electron_mirror).
# Unset, both requests go to github.com: the checksum fetch alone measured ~15s
# and stalls outright when the release CDN is unreachable, which drops the whole
# packaging run into a full re-download of the ~120 MB zip.
electron_mirror=https://npmmirror.com/mirrors/electron/
